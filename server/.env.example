DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PORT=3000

# Comma-separated IP/CIDR of the reverse proxy actually in front of this
# process. Only X-Forwarded-For values relayed by these addresses are
# trusted; a hop count is not accepted because it can't validate who the
# immediate peer is. An over-broad value lets a client forge the header and
# defeat every per-IP rate limit. Defaults to loopback when unset.
TRUST_PROXY=127.0.0.1,::1

# Backs rate limiting with Redis so limits survive restarts and are shared
# across instances. Without it, limits are in-memory and per-process.
REDIS_URL=redis://localhost:6379

# Absolute ceilings independent of per-IP rate limits, protecting against a
# flood spread across many IPs. MAX_TOTAL_STORED_BYTES is in bytes.
MAX_LIVE_ENDPOINTS=5000
MAX_TOTAL_STORED_BYTES=2147483648
