# Required when NODE_ENV=production (see below); the process refuses to
# boot without it. Optional in development, where it's fine for the API to
# reflect any origin back — set it anyway to match your frontend's URL if
# you want CORS behavior closer to production.
WEB_ORIGIN=https://your-frontend.example

# development or production. In production, config.ts requires WEB_ORIGIN
# and refuses to start without it rather than silently allowing any origin.
NODE_ENV=development

DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PORT=3000

# TLS certificate verification is on by default for any non-localhost
# DATABASE_URL, checked against Node's trust store — already correct for a
# provider using a publicly-trusted CA. Only set these if that's not enough:
#
# PEM contents of an additional CA to trust, for a provider whose
# certificate isn't signed by a publicly-trusted CA.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# Disables certificate verification entirely. Never set this in production —
# it means a network-level attacker can read or alter every query.
# DATABASE_INSECURE_TLS=true

# Bounds on the runtime connection pool, so a burst of slow requests or a
# single stuck query can't starve every other query. Milliseconds.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Connection string used only by `npm run migrate`, under a role with DDL
# rights (see sql/roles.sql). DATABASE_URL, used by the running app, should
# point at the least-privilege role that script creates instead. Falls back
# to DATABASE_URL when unset, which is fine for a single-role local database.
MIGRATION_DATABASE_URL=postgres://owner:password@host/dbname?sslmode=require

# Comma-separated IP/CIDR of the reverse proxy actually in front of this
# process. Only X-Forwarded-For values relayed by these addresses are
# trusted; a hop count is not accepted because it can't validate who the
# immediate peer is. An over-broad value lets a client forge the header and
# defeat every per-IP rate limit. Defaults to loopback when unset.
TRUST_PROXY=127.0.0.1,::1

# Backs rate limiting with Redis so limits survive restarts and are shared
# across instances. Without it, limits are in-memory and per-process.
REDIS_URL=redis://localhost:6379

# Absolute ceilings independent of per-IP rate limits, protecting against a
# flood spread across many IPs. MAX_TOTAL_STORED_BYTES is in bytes.
MAX_LIVE_ENDPOINTS=5000
MAX_TOTAL_STORED_BYTES=2147483648
